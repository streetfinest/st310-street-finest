# Optional settings. Copy this file to .env BEFORE THE FIRST LAUNCH.
# If blank/unset, secure random admin and CR invite codes are generated on first run.
# Never place real secrets in a public repository.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=choose-a-long-unique-secret
# APP_SECRET_KEY=choose-a-long-random-token
# CR_INVITE_MATH=private-code-for-the-math-and-statistics-cr
# CR_INVITE_BAEST=private-code-for-baest-cr
# CR_INVITE_BAST=private-code-for-bast-cr
# DB_PATH=C:/path/to/persistent/storage/st310.sqlite3
# ACADEMIC_YEAR=2026/2027
